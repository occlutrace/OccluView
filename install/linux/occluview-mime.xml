<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-ply">
    <comment>PLY mesh</comment>
    <glob pattern="*.ply" />
    <glob pattern="*.PLY" />
  </mime-type>
  <mime-type type="application/x-occluview-hps">
    <comment>HPS mesh package</comment>
    <glob pattern="*.hps" />
    <glob pattern="*.HPS" />
    <!-- Below the shared database's own `50:application/dicom:*.dcm`. 3Shape
         writes HPS containers with a .dcm extension, so OccluView must still
         recognise them, but at the default weight of 50 OccluView wins the tie
         and takes the icon, the default application and the thumbnailer for
         every medical DICOM on the machine. At weight 40 application/dicom
         wins deterministically and OccluView stays in the "Open With" list. -->
    <glob pattern="*.dcm" weight="40" />
    <glob pattern="*.DCM" weight="40" />
  </mime-type>
</mime-info>
